# Copy to .env and adjust. All values are optional; defaults live in app/config.py.

# PostgreSQL (database must already exist)
DATABASE_URL=postgresql://postgres:password@localhost:5432/office_hours

# SQLite alternative: no database server needed, file is created on first run
# DATABASE_URL=sqlite:///./office_hours.db

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
